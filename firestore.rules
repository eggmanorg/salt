rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // True when the caller is an admin member (issue #155). Member docs are
    // keyed by the normalised email, which equals the Auth ID-token email
    // claim, so we can resolve the caller's own doc with a direct get() and
    // read its admin flag — no query needed.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/members/$(request.auth.token.email))
        && get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.admin == true;
    }

    // Members allowlist — any signed-in user may read the roster (and the app
    // reads it to resolve admin-ness for the operator UI); only admins may
    // create/delete a member, or edit anyone's. Off-list accounts never get
    // created in the first place (beforeMemberCreated blocking function), so
    // "signed in" here already means "an allowlisted member".
    //
    // THE ONE EXCEPTION (issue #776): a member may update their OWN doc to
    // change `cookMode`, the preference deciding which cook mode their Cook
    // button opens. It is set in Settings by the person it describes, because it
    // is a preference about how they like to cook rather than an administrative
    // fact about the household.
    //
    // This doc carries the `admin` flag, so that exception is the whole security
    // surface of the feature: without pinning, "let me change my cooking
    // preference" is also "let me make myself an admin". The client writes the
    // WHOLE document (`upsertMember` does a full setDoc), so the guard is stated
    // as "which keys actually differ" rather than as a list of things to hold
    // equal — `diff().affectedKeys().hasOnly(...)` covers every field the doc has
    // now AND every field added to it later, which an enumeration would not.
    //
    // Written this way for a second reason: `icon` carries `.default(null)`, so
    // member docs written before it existed have no such key at all. Comparing
    // `request.resource.data.icon == resource.data.icon` on one of those reads a
    // missing key and denies the write — a rule that works everywhere except on
    // the oldest accounts, which is the kind of thing that ships green.
    //
    // `updatedAt` is in the allowed set because the domain command re-stamps it
    // on every patch. `cookMode` is additionally constrained to the two values
    // the schema allows: a rule that let a member write any string here would let
    // them store arbitrary data on a family-readable document.
    //
    // `system` (issue #1300) appears in the allowed-keys set AND is pinned equal
    // on both sides, which is two separate jobs on one field. The PIN is what
    // makes the flag admin-only: a non-admin self-update that flips it is denied.
    // Its PRESENCE in `hasOnly` is what keeps the cook-mode exception working at
    // all — the client writes the whole document, the schema's `.default(false)`
    // materialises `system: false` on a doc that has no such key, and
    // `affectedKeys()` therefore contains `system` on the first Settings save by
    // anyone whose doc predates the field. Most production member docs are in
    // exactly that state, so a two-key allowlist would lock them out of their own
    // preference the moment this shipped. `.get(field, default)` on BOTH sides,
    // because a bare `resource.data.system` errors on a doc missing the key —
    // the same trap `icon` set above, arriving by a different route.
    function isSelf(email) {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == email;
    }
    function onlyCookModeChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['cookMode', 'updatedAt', 'system'])
        && request.resource.data.get('system', false) == resource.data.get('system', false)
        && request.resource.data.cookMode in ['standard', 'guided'];
    }
    match /members/{email} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSelf(email) && onlyCookModeChanged());
    }

    // Canon items — shared ingredient canon; any authenticated user can read and write.
    match /canonItems/{itemId} {
      allow read, write: if request.auth != null;
    }
    // Canon embeddings (issue #410) — server-only name vectors, relocated off the
    // client-subscribed canonItems doc. Written and read exclusively by the Cloud
    // Functions match path via the Admin SDK (which bypasses these rules); no
    // client ever needs them, so all client access is denied. Closing it here is
    // what guarantees the browser stops paying to sync vectors it never reads.
    match /canonEmbeddings/{itemId} {
      allow read, write: if false;
    }
    // Product forms — shared mapping of alternate ingredient forms to a parent
    // canon item + yield; any authenticated user can read and write (mirrors
    // canonItems; the AdminGuard on the management UI is cosmetic, #157).
    match /productForms/{formId} {
      allow read, write: if request.auth != null;
    }
    // Kitchen tools (issue #882) — the curated pictogram vocabulary a recipe's or
    // a plan's free-text container words are resolved against at display time.
    // Client-writable, mirroring `canonItems` and `productForms` rather than the
    // server-only `equipmentIcons` block: this collection follows the CANON model,
    // where the client owns the document and the trigger only stamps the generated
    // `thumbnail` back onto it (via the Admin SDK, which bypasses these rules).
    // That is what lets the admin page add a tool, regenerate its picture or hide
    // it with plain client writes — no callable, and no rules change.
    match /kitchenTools/{toolId} {
      allow read, write: if request.auth != null;
    }
    // Aisle config — shared; any authenticated user can read and write.
    match /canonData/{document} {
      allow read, write: if request.auth != null;
    }
    // Equipment manifest — single doc, shared; any authenticated user can read and write.
    match /equipmentManifest/{document} {
      allow read, write: if request.auth != null;
    }
    // Equipment pictograms (issue #877) — one server-written doc per equipment
    // item, holding the appliance description and the generated icon. Written
    // ONLY by the brief trigger and the Draw callable via the Admin SDK (which
    // bypasses these rules); the client reads them to render the list and the
    // detail page, and reaches every mutation through the authenticated
    // `drawEquipmentIcon` callable. So unlike `canonEmbeddings` above — which is
    // fully closed because no client ever needs it — this one is READABLE and
    // write-denied.
    match /equipmentIcons/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Shopping lists and items — shared; any authenticated user can read and write.
    match /shoppingLists/{listId} {
      allow read, write: if request.auth != null;
      match /items/{itemId} {
        allow read, write: if request.auth != null;
      }
    }
    // Shopping lists config — singleton doc; any authenticated user can read and write.
    match /shoppingListsConfig/{document} {
      allow read, write: if request.auth != null;
    }
    // Shop days (issue #629) — one tiny doc per shop trip, keyed by the local
    // calendar date. FAMILY-SHARED like the planner it belongs to: when the
    // household shops is not personal information, and anyone may move it.
    // `setBy` is an audit field only and is deliberately NOT pinned — the point
    // is that either of them can reschedule the other's shop. The daily reminder
    // reads it via the Admin SDK (bypasses rules).
    match /shoppingDays/{date} {
      allow read, write: if request.auth != null;
    }
    // Meal planning (issue #169) — all shared, family-wide; any authenticated
    // user can read and write. The template/first-day AdminGuard is cosmetic UI
    // only and is deliberately NOT enforced here (docs/meal-planning.md).
    match /mealPlanConfig/{document} {
      allow read, write: if request.auth != null;
    }
    match /mealPlanTemplate/{document} {
      allow read, write: if request.auth != null;
    }
    match /mealPlans/{startDate} {
      allow read, write: if request.auth != null;
    }
    // Recipes (issue #179) — shared, family-wide; any authenticated user can
    // read and write. No AdminGuard on recipes (writes are open to members).
    match /recipes/{recipeId} {
      allow read, write: if request.auth != null;
    }
    // Guided plans (issue #751) — one doc per recipe at guidedPlans/{recipeId},
    // holding the prep list and the notes that sit under the recipe's steps.
    // FAMILY-SHARED like the recipe it belongs to, and mirroring the `recipes`
    // block above deliberately: a plan is a rendering of a family-shared dish, not
    // personal state, so it carries NO ownerUid and is NOT a fourth per-user
    // collection. Either member may write, re-run or hand-correct the other's
    // plan, exactly as either may edit the other's recipe.
    //
    // Unlike cookSessions the deterministic id needs no `resource == null` clause:
    // this rule never dereferences `resource.data`, so reading or deleting a plan
    // that does not exist yet — which the editor does on every first visit — is
    // evaluated and allowed on the strength of `request.auth` alone.
    match /guidedPlans/{recipeId} {
      allow read, write: if request.auth != null;
    }
    // Formulas (issue #806, epic #778) — one doc per recipe at
    // formulas/{recipeId}, holding the composition as baker's percentages against
    // a declared basis. FAMILY-SHARED like the recipe it describes and like the
    // guidedPlans block above: a formula is a reading of a family-shared dish, not
    // personal state, so it carries NO ownerUid and is not a per-user collection.
    // Either member may map, re-map or correct the other's formula.
    //
    // Follows guidedPlans, NOT cookSessions: the deterministic id needs no
    // `resource == null` clause because this rule never dereferences
    // `resource.data`, so reading a formula that does not exist yet — which the
    // formula screen does on every first visit — is evaluated and allowed on the
    // strength of `request.auth` alone.
    match /formulas/{recipeId} {
      allow read, write: if request.auth != null;
    }
    // Batches (issue #812, epic #778) — one doc per RUN at batches/{batchId},
    // holding the quantities, totals and schedule frozen at the moment it started.
    // FAMILY-SHARED, and here that is not merely consistency: either partner may
    // glance at the crock, mark the prove done and take the loaf out. The id is a
    // random UUID rather than a recipe id — a recipe has many runs — so this is a
    // collection the in-flight surface queries, not a doc it looks up.
    //
    // Follows guidedPlans and formulas, NOT cookSessions: no ownerUid, no pinning,
    // and no `resource == null` clause, because this rule never dereferences
    // `resource.data`.
    //
    // The observation log is a SUBCOLLECTION under the run, and the nesting is what
    // the rule mirrors: shoppingLists/{listId}/items above is the only precedent,
    // and it gates the child exactly as it gates the parent. Same signed-in gate
    // here, and for the same family-shared reason — one of them weighs the coppa,
    // the other reads what it weighed. A subcollection rather than an array field
    // because the log is append-only over weeks and two people logging a weight on
    // the same day must not clobber each other under document-level LWW.
    //
    // Photos are NOT written from here: the client sends bytes to the
    // setObservationImageUpload callable and the Admin SDK writes the object, so
    // storage.rules stay `write: if false` (see storage.rules).
    match /batches/{batchId} {
      allow read, write: if request.auth != null;
      match /observations/{observationId} {
        allow read, write: if request.auth != null;
      }
    }
    // Kitchen memories (issue #816) — the notes the household writes for the chef
    // ("we hate coriander", "the oven runs hot"). FAMILY-SHARED, and here that is
    // the feature rather than a default: anyone in the household can add, see and
    // remove any note, whoever typed it. This is a shared kitchen, and a standing
    // note about how the two of them cook belongs to both of them.
    //
    // So: NO ownerUid, and this is not a fourth per-user collection. The `author`
    // field is a display NAME denormalised at write time so a note can say who
    // wrote it — deliberately not a uid, keeping the invariant that uids appear
    // nowhere in the family-shared data model.
    //
    // Mirrors the guidedPlans block above, including its lack of a
    // `resource == null` clause: this rule never dereferences `resource.data`.
    match /kitchenMemories/{memoryId} {
      allow read, write: if request.auth != null;
    }
    // Development settings (issue #238) — per-environment operator switches
    // (e.g. the canon-icon generation kill-switch). Any signed-in user may read
    // (the CF trigger uses the Admin SDK and bypasses rules anyway); only admins
    // may change them. Unlike the cosmetic AdminGuard on meal-plan settings,
    // admin-only writes ARE enforced here.
    match /devSettings/{document} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    // AI model settings (admin-managed model selection) — per-environment
    // singleton naming the Gemini model for each AI role. The CF model resolver
    // reads it via the Admin SDK (bypasses rules); any signed-in user may read
    // (the admin UI shows the effective config); only admins may change it.
    match /appSettings/{document} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    // Weather forecast cache (issue #382) — a single CF-written singleton
    // (weatherForecast/singleton). The refreshWeatherForecast callable writes it
    // via the Admin SDK (which bypasses rules); any signed-in user may read it so
    // the planner can render each in-window day's evening forecast. Clients never
    // write it directly (refreshes go through the callable, not a direct doc
    // write), so writes are closed here.
    match /weatherForecast/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Chat sessions (issue #206) — the first per-user-scoped data in Salt.
    // A session may only be read or written by the user who owns it.
    // On create, the client must set ownerUid to their own uid; on update the
    // ownerUid is pinned to its existing value so an owner cannot reassign a
    // session to another user (issue #408). List queries are scoped to
    // ownerUid == request.auth.uid via client-side where() so the read/delete
    // rule only needs to check the authenticated user against the existing doc.
    match /chatSessions/{sessionId} {
      allow read, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
    }
    // Cook sessions (cooking mode) — per-user-scoped, mirroring chatSessions.
    // A session may only be read or written by the user who owns it. On create the
    // client must set ownerUid to their own uid; on update the ownerUid is pinned
    // to its existing value so an owner cannot reassign a session to another user.
    // The deterministic id (`${recipeId}_${uid}`) means each user has exactly one
    // session per recipe; the read/delete rule checks the authenticated user
    // against the existing doc's ownerUid.
    //
    // `resource == null` on read/delete is load-bearing, and the one place this
    // diverges from chatSessions (issue #558). Because the id is deterministic,
    // the cook page subscribes to `${recipeId}_${uid}` BEFORE the session exists
    // and only then bootstraps it — and a rule that dereferences `resource.data`
    // cannot be evaluated against an absent document (Null value error), so
    // Firestore denied that read outright and tore the listener down for good:
    // the first cook of a recipe ran with a dead subscription and reported a
    // spurious permission-denied. The same applies to deleting an already-absent
    // session (the deleted-recipe orphan cleanup). chatSessions needs no such
    // clause because it is only ever read through a collection query filtered on
    // ownerUid, never by a single id that may not exist yet.
    //
    // This grants nothing but absence: an absent doc has no data to leak, and the
    // permit/deny split still tells a caller only whether an id is in use — which
    // requires already knowing another member's uid (uids appear nowhere in the
    // family-shared data model; members are keyed by email). Every session that
    // actually exists stays owner-only on read, update and delete.
    match /cookSessions/{sessionId} {
      allow read, delete: if request.auth != null
        && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
    }
    // E2E AI fake-model stubs (test-infra Phase 1). The browser e2e bridge
    // writes canned AI answers here; the CF fake model reads them (Admin SDK,
    // bypasses rules). Underscore-prefixed: test-only scaffolding that never
    // exists in production data. The CF fake model that consumes it is itself
    // hard-gated on FUNCTIONS_AI_FAKE=1 (emulator only), so even though this
    // rule ships in the production ruleset the collection is inert there —
    // nothing writes it (the bridge is gated on VITE_USE_EMULATORS) and nothing
    // reads it (the fake model is unreachable without the emulator flag). Scoped
    // to allowlisted, signed-in members only.
    match /_e2e_ai_stubs/{flowName} {
      allow read, write: if request.auth != null;
    }
    // Email-OTP sign-in codes (issue #546). Server-only: written and read
    // exclusively by the requestEmailOtp / verifyEmailOtp callables via the Admin
    // SDK (which bypasses these rules). Holds only hashed codes keyed by a hashed
    // email — never a raw address — and no client ever touches it, so all client
    // access is denied.
    match /emailOtps/{emailHash} {
      allow read, write: if false;
    }
    // Web-push subscriptions for cook-timer notifications (issue #544). The third
    // owner-scoped collection (see the "Per-user exceptions" note in CLAUDE.md /
    // docs/salt-architecture.md) — one doc per device, id `${uid}_${deviceHash}`,
    // ownerUid pinned on update so a device can't be reassigned to another user.
    // Mirrors cookSessions, including the `resource == null` clause: the id is
    // deterministic so the client may read/delete its own doc before it exists (or
    // after the server pruned a dead subscription) — a rule that dereferenced
    // resource.data on an absent doc would be denied and throw. CFs read every
    // subscription via the Admin SDK (bypasses rules) to send.
    match /pushSubscriptions/{subId} {
      allow read, delete: if request.auth != null
        && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
    }
    // Standalone kitchen timers (issue #842). The FOURTH owner-scoped collection
    // (see the "Per-user exceptions" note in CLAUDE.md / docs/salt-architecture.md)
    // — one doc per user holding an array of timers that belong to nobody's cook.
    //
    // NO `resource == null` CLAUSE, DELIBERATELY, and it must not be "restored".
    // cookSessions and pushSubscriptions both need one because their ids are
    // COMPOSITE and the client subscribes before the doc exists, so a rule that
    // dereferenced `resource.data` on an absent document would be denied and kill
    // the listener for good (#558). Here the document id simply IS the uid, so
    // ownership is provable from the path and no rule below ever dereferences
    // `resource.data` at all — the absent-document problem cannot arise. Adding
    // the clause would be cargo-cult.
    //
    // The `ownerUid` FIELD is still stored and still pinned on write, because
    // onKitchenTimerDispatch reads it off the parsed document to target
    // pushSubscriptions — so the send target is proven by the same document that
    // armed the timer, exactly as onCookTimerDispatch reads `session.ownerUid`.
    match /kitchenTimers/{ownerUid} {
      allow read, delete: if request.auth != null && ownerUid == request.auth.uid;
      allow create, update: if request.auth != null
        && ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
    }
    // Server-owned exactly-once delivery ledger (issue #544). Written and read
    // only by the Admin SDK senders, to dedupe Cloud Tasks retries + duplicate
    // enqueues. Deliberately a SEPARATE doc from whatever caused the send (never
    // a write-back onto a client-owned document — full-doc setDoc LWW would
    // clobber it). No client ever touches it.
    //
    // SEVERAL PRODUCERS, ONE COLLECTION (issues #812, #842): onCookTimerDispatch
    // keys `${sessionId}_${timerId}_${endsAtMs}`, onBatchStageDispatch keys
    // `batch_${batchId}_${stageId}_${plannedStartAtMs}`, onKitchenTimerDispatch
    // keys `kitchen_${uid}_${timerId}_${endsAtMs}`. Same rules, same kind, same
    // purpose — a twin collection would be duplication, so this block covers all
    // of them and has needed no change to do it. A fourth prefix goes here too.
    match /timerDeliveries/{deliveryId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
