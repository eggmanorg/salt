# Stream Firestore to BigQuery — batches (issue #1403).
# Firestore for this app lives in nam5 (US multi-region) — verified on prod, not
# assumed from the europe-west2 functions region — so the dataset colocates in
# the US rather than following the EU-for-PostHog convention: the source data is
# already there.
#
# The readings logged against a run live in `batches/{batchId}/observations`,
# which this instance does NOT see: the extension's trigger covers the one
# collection path it is given and does not descend into subcollections (its own
# pre-install documentation says so). That is why
# bq-export-batch-observations.env exists beside this file.
DATASET_LOCATION=us
DATABASE=(default)
DATABASE_REGION=nam5
COLLECTION_PATH=batches
DATASET_ID=firestore_export
TABLE_ID=batches
VIEW_TYPE=view
USE_NEW_SNAPSHOT_QUERY_SYNTAX=yes
