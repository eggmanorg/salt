# Stream Firestore to BigQuery — batch observations (issue #1403).
# Firestore for this app lives in nam5 (US multi-region) — verified on prod, not
# assumed from the europe-west2 functions region — so the dataset colocates in
# the US rather than following the EU-for-PostHog convention: the source data is
# already there.
#
# COLLECTION_PATH is the extension's `{wildcard}` notation, not a Firestore
# collection-group name. The bare group name `observations` would match the same
# documents as things stand — `storageSweepTargets.ts` records that
# `batches/{batchId}/observations` is the only collection in the database using
# that group name — but it names no parent, so a later `observations`
# subcollection under a different parent would widen the export without anything
# saying so. The wildcard form is the same query with the parent asserted.
#
# WILDCARD_IDS=yes is what makes a reading attributable: it adds a `path_params`
# column holding the captured `batchId` as JSON, which is the join key back to
# the `batches` table. Without it a row carries its own document id and no
# parent. See the README's "Joining an observation to its batch".
#
# TABLE_ID is `batchObservations`, not `observations`: the other table ids equal
# their collection name because those names are unambiguous at the root, and a
# bare `observations` would read as a top-level collection that does not exist.
DATASET_LOCATION=us
DATABASE=(default)
DATABASE_REGION=nam5
COLLECTION_PATH=batches/{batchId}/observations
DATASET_ID=firestore_export
TABLE_ID=batchObservations
VIEW_TYPE=view
WILDCARD_IDS=yes
USE_NEW_SNAPSHOT_QUERY_SYNTAX=yes
