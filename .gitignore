# macOS Finder metadata
.DS_Store

node_modules/
dist/
storybook-static/
build-storybook.log
.svelte-kit/
.firebase/
*.local
.env
.env.local
.env.*.local
*.tsbuildinfo
.emulator-data/
firebase-debug.log
firestore-debug.log
firebase-export*/
# Written by `firebase deploy --only extensions` in infra/bigquery-export: install
# etags for the four BigQuery-export instances, i.e. CLI bookkeeping about what is
# live on prod right now. The root .firebaserc is the tracked one (project
# aliases); this sibling holds no configuration and would only ever conflict.
infra/bigquery-export/.firebaserc
.vexp/manifest.json
apps/web-pwa/test-results/
apps/web-pwa/playwright-report/
apps/web-pwa/playwright/.cache/
# Flake telemetry emitted by e2e/reporter/flakeReporter.ts (issue #669); CI ships
# it to PostHog and drops it with the runner.
apps/web-pwa/e2e-flake-events.ndjson
# Server-side e2e logs captured for CI artifacts: the emulator container's own
# logs (written by globalTeardown before `down -v` takes the container with it)
# and the e2e Vite server log. Local runs regenerate both.
apps/web-pwa/e2e-emulator.log
apps/web-pwa/e2e-vite.log
apps/cloud-functions/.secret.local
apps/cloud-functions/.genkit/
coverage/
tmp/

# Claude Code local runtime state. `.claude/commands/` and `.claude/settings.json`
# are the checked-in, shared parts; everything below is per-machine (pids, session
# ids, scratch checkouts) and was previously only covered by .git/info/exclude,
# which is local-only and so let scheduled_tasks.lock get committed once already.
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/settings.local.json
.claude/worktrees/

# Marker written by e2e globalSetup recording the build inputs the running
# test-emulator image was built from (drives the stale-image rebuild check).
docker/test-emulators/.image-build-hash

# Serena MCP (oraios/serena) — local semantic-code-search state, entirely
# machine-specific and regenerable via `serena project index`. Nothing under
# .serena/ belongs in git: cache/ is the LSP symbol index, logs/ is noise, and
# project.yml is regenerated on activation.
#
# NOTE: project.yml's defaults are WRONG for this repo and must be re-applied
# after any regeneration — `language_servers: [typescript]` (#1086 tested
# adding Svelte support: it silently attached unrelated files to real
# cross-file results, not just gaps, so semantic tools stay TS-only here) and
# `ignored_paths: [".claude/**"]` (otherwise it indexes the 18 duplicate
# checkouts under .claude/worktrees/ despite them being gitignored: 17,734 files
# and ~59 min, versus ~790 files in ~3 min when scoped correctly).
.serena/
