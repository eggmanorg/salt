{
	"servers": {
		"github": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-github"
			],
			"env": {
				"GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
			}
		},
		"appmap": {
			"type": "stdio",
			"command": "${userHome}/.appmap/bin/appmap",
			"args": [
				"query",
				"mcp"
			]
		}
	}
}
